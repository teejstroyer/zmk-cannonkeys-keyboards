#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // needed for home row mods
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            //hold-trigger-key-positions = < ... >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC       &kp N1         &kp N2        &kp N3        &kp N4         &kp N5                             &kp N6  &kp N7       &kp N8        &kp N9        &kp N0            &kp BACKSPACE
&kp GRAVE     &kp Q          &kp W         &kp E         &kp R          &kp T                              &kp Y   &kp U        &kp I         &kp O         &kp P             &kp BSLH
&kp TAB       &hm LCTRL A    &hm LALT S    &hm LGUI D    &hm LSHFT F    &kp G                              &kp H   &hm RSHFT J  &hm RGUI K    &hm RALT L    &hm RCTRL SEMI    &kp APOS
&kp LSHFT     &kp Z          &kp X         &kp C         &kp V          &kp B     &kp C_MUTE    &kp C_PP   &kp N   &kp M        &kp COMMA     &kp DOT       &kp FSLH          &kp RSHFT
                             &kp LCTRL     &kp LALT      &kp LGUI       &mo 1     &kp RET       &kp SPACE  &mo 2   &kp RGUI     &kp RALT      &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        lower_layer {
            bindings = <
&studio_unlock &kp F1    &kp F2    &kp F3   &kp F4    &kp F5                                &kp F6      &kp F7            &kp F8          &kp F9       &kp F10   &kp F11
&trans         &trans    &trans    &trans   &trans    &trans                                &kp HOME    &kp PAGE_DOWN     &kp PAGE_UP     &kp END      &trans    &kp F12
&trans         &trans    &trans    &trans   &trans    &trans                                &kp LEFT    &kp DOWN          &kp UP          &kp RIGHT    &trans    &trans
&trans         &trans    &trans    &trans   &trans    &trans    &trans            &trans    &trans      &trans            &trans          &kp DEL      &trans    &trans
                         &trans    &trans   &trans    &trans    &bootloader       &trans    &tog 3      &trans            &trans          &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        raise_layer {
            bindings = <
&trans         &kp F1          &kp F2          &kp F3          &kp F4          &kp F5                                &kp F6    &kp F7       &kp F8      &kp F9            &kp F10      &kp F11
&bt BT_CLR     &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                          &trans    &kp LBRC     &kp LBKT    &kp RBKT          &kp RBRC     &kp F12
&trans         &trans          &trans          &trans          &trans          &trans                                &trans    &kp MINUS    &kp PLUS    &kp UNDERSCORE    &kp EQUAL    &trans
&trans         &trans          &trans          &trans          &trans          &trans       &trans    &trans         &trans    &trans       &trans      &trans            &trans       &trans
                               &trans          &trans          &trans          &trans       &trans    &bootloader    &trans    &trans       &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;
        };

        Gaming {
            bindings = <
&kp ESC       &kp N1         &kp N2        &kp N3        &kp N4         &kp N5                             &kp N6   &kp N7       &kp N8        &kp N9        &kp N0      &kp BACKSPACE
&kp GRAVE     &kp Q          &kp W         &kp E         &kp R          &kp T                              &kp Y    &kp U        &kp I         &kp O         &kp P       &kp BSLH
&kp TAB       &kp A          &kp S         &kp D         &kp F          &kp G                              &kp H    &kp J        &kp K         &kp L         &kp SEMI    &kp APOS
&kp LSHFT     &kp Z          &kp X         &kp C         &kp V          &kp B     &kp C_MUTE    &kp C_PP   &kp N    &kp M        &kp COMMA     &kp DOT       &kp FSLH    &kp RSHFT
                             &trans        &kp LCTRL     &kp SPACE      &kp RET   &trans        &kp SPACE  &tog 3   &kp RGUI     &kp RALT      &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_DN PG_UP>;

        };

        // Extra layers
        extra_layer2 {
            status = "reserved";
        };

        extra_layer3 {
            status = "reserved";
        };
    };
};
